{
  "name": "ezequielpaiva-site",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm run build:css && pnpm run generate:sitemap && pnpm run check",
    "build:css": "tailwindcss -i ./input.css -o ./tailwind.css --minify",
    "watch:css": "tailwindcss -i ./input.css -o ./tailwind.css --watch",
    "generate:sitemap": "node ./scripts/generate-sitemap.js",
    "check": "pnpm run check:links && pnpm run check:security",
    "check:links": "node ./scripts/check-links.js",
    "check:security": "node ./scripts/check-security.js"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
